# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local database (npm run db:local)
/.data/

# uploaded media (demo files live under content/demo, not public/)
/public/media/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Word extract (originals stay local; import copies bytes into media_blobs)
/docs/backups/alfa-visits/unzipped/
/docs/backups/alfa-visits/source.docx
/docs/backups/alfa-visits/source.zip
/docs/backups/kadro-team/unzipped/
/docs/backups/kadro-team/source.docx
/docs/backups/kadro-team/source.zip
/docs/backups/kadro-team-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
