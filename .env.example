# Copy to .env.local (or the host secret store). Never commit real values.
# `npm run release:check-env` prints names only, never secret values.

# --- Stage ---
# development | staging | production
# SITE_ENV=production always hides demo rows and demo media files.
SITE_ENV=development

# Show clearly marked demo content outside production (true | false).
# Defaults to on in `next dev`, off in production builds (`NODE_ENV=production`).
# Presentation preview: SITE_ENV=staging and ALLOW_DEMO_CONTENT=true.
# SITE_ENV=production always hides demo rows, even if this is true.
ALLOW_DEMO_CONTENT=

# Script-only: allow `npm run db:seed:demo` to write is_demo rows when SITE_ENV
# is still production. Does not make those rows public. Remove after the seed.
# ALLOW_DEMO_SEED=

# Public origin used for canonical URLs, hreflang and the sitemap.
# Leave empty locally; sitemap stays empty until this is an https origin.
# Example for a real launch (replace with the real domain when it exists):
# SITE_URL=https://www.example.com
SITE_URL=

# --- Database ---
# Required for `next dev`, `next build` (pages read published content at build
# time) and `next start`. For `npm run db:local`, pick your own user/password;
# the script creates the database. Do not use the embedded Postgres in production.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
# On Vercel, also accepted: POSTGRES_URL / POSTGRES_URL_NON_POOLING (Neon).
# Prefer the direct (non-pooling) URL for this app’s node-postgres driver.
# Enable Production, Preview AND Development.
DATABASE_URL=

# Optional: connection pool size per Node process (default 5).
DATABASE_POOL_MAX=

# --- Admin sessions (Better Auth) ---
# Required. Random secret, at least 32 characters, unique per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public origin of the panel (defaults to SITE_URL). Must match the browser URL
# used to sign in (scheme + host), e.g. https://www.example.com
BETTER_AUTH_URL=

# Trusted reverse-proxy header for the client IP (x-real-ip or x-forwarded-for).
# Leave empty if nothing trusted sets one: sign-in throttling is then per e-mail only.
AUTH_IP_HEADER=

# Only for `npm run admin:create` (first administrator). Prefer the interactive
# prompt. If set here, remove them after the account exists. Never log these.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Media ---
# Public base URL of stored files. Defaults to /media (GET /media/[...key]).
# Point this at a CDN origin only after object storage exists (not implemented).
MEDIA_PUBLIC_BASE_URL=

# Durable directory for uploaded bytes. Defaults to .data/media.
# In production this must be a mounted volume that survives deploys.
# Ephemeral app disks (typical serverless) will lose uploads.
MEDIA_STORAGE_DIR=

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO). Required on Vercel
# for panel uploads and Sharp derivatives to survive deploys. Server-side only.
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=

# --- Optional inquiry e-mail (Resend) ---
# If unset, the inquiry is still saved; notify_status stays skipped.
# RESEND_API_KEY=
# INQUIRY_NOTIFY_TO=
# INQUIRY_NOTIFY_FROM=
